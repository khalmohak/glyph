{
  "name": "glyph-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:exports && pnpm size",
    "test:coverage": "turbo run test:coverage",
    "test:consumer": "node e2e/consumer/run.mjs",
    "e2e": "pnpm -C apps/docs e2e",
    "size": "node scripts/size.mjs",
    "changeset": "changeset",
    "release": "turbo run build check:exports --filter='./packages/*' && pnpm publish -r --access public --provenance --no-git-checks && changeset tag",
    "prepare": "simple-git-hooks",
    "check:exports": "turbo run check:exports"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "rolldown": "1.2.13",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.6",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalmohak/glyph.git"
  },
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
