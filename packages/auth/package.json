{
  "name": "@glyphui/auth",
  "version": "0.8.2",
  "description": "Authentication for Glyph apps: session state, protected routes and ready sign-in screens, with adapters for your own REST API, Firebase and Clerk.",
  "license": "MIT",
  "author": "Mohak Gupta (https://github.com/khalmohak)",
  "homepage": "https://glyphui.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalmohak/glyph.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/khalmohak/glyph/issues"
  },
  "keywords": [
    "react",
    "auth",
    "authentication",
    "protected-routes",
    "react-router",
    "firebase",
    "clerk",
    "design-system",
    "ai",
    "ai-agents",
    "mcp",
    "llms-txt",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@glyphui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rest": {
      "@glyphui/source": "./src/adapters/rest.ts",
      "types": "./dist/adapters/rest.d.ts",
      "default": "./dist/adapters/rest.js"
    },
    "./memory": {
      "@glyphui/source": "./src/adapters/memory.ts",
      "types": "./dist/adapters/memory.d.ts",
      "default": "./dist/adapters/memory.js"
    },
    "./firebase": {
      "@glyphui/source": "./src/adapters/firebase.ts",
      "types": "./dist/adapters/firebase.d.ts",
      "default": "./dist/adapters/firebase.js"
    },
    "./clerk": {
      "@glyphui/source": "./src/adapters/clerk.tsx",
      "types": "./dist/adapters/clerk.d.ts",
      "default": "./dist/adapters/clerk.js"
    },
    "./react-router": {
      "@glyphui/source": "./src/react-router/index.tsx",
      "types": "./dist/react-router/index.d.ts",
      "default": "./dist/react-router/index.js"
    },
    "./ui": {
      "@glyphui/source": "./src/ui/index.ts",
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.test-d.ts",
    "!src/test"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@clerk/react": ">=6",
    "@glyphui/blocks": ">=0.7.0",
    "@glyphui/tokens": ">=0.7.0",
    "@glyphui/ui": ">=0.7.0",
    "@hookform/resolvers": ">=5.1.0",
    "firebase": ">=11",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.55.0",
    "react-router": ">=7",
    "tailwindcss": ">=4.1"
  },
  "peerDependenciesMeta": {
    "@clerk/react": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@clerk/react": "6.17.8",
    "@glyphui/blocks": "workspace:*",
    "@glyphui/tokens": "workspace:*",
    "@glyphui/tsconfig": "workspace:*",
    "@glyphui/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "firebase": "12.19.0",
    "jsdom": "^27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "tsdown": "^0.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
