{
  "name": "@glyphui/viewers",
  "version": "0.5.0",
  "description": "File and data viewers for Glyph: PDF, CSV, spreadsheets, JSON, code, Markdown, diffs, images, video and audio. Themed by your Glyph theme.",
  "license": "MIT",
  "author": "Mohak Gupta (https://github.com/khalmohak)",
  "homepage": "https://github.com/khalmohak/glyph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalmohak/glyph.git",
    "directory": "packages/viewers"
  },
  "bugs": {
    "url": "https://github.com/khalmohak/glyph/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "pdf-viewer",
    "csv-viewer",
    "json-viewer",
    "file-preview",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@glyphui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "@glyphui/source": "./src/pdf/index.ts",
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    },
    "./csv": {
      "@glyphui/source": "./src/csv/index.ts",
      "types": "./dist/csv.d.ts",
      "default": "./dist/csv.js"
    },
    "./spreadsheet": {
      "@glyphui/source": "./src/spreadsheet/index.ts",
      "types": "./dist/spreadsheet.d.ts",
      "default": "./dist/spreadsheet.js"
    },
    "./json": {
      "@glyphui/source": "./src/json/index.ts",
      "types": "./dist/json.d.ts",
      "default": "./dist/json.js"
    },
    "./code": {
      "@glyphui/source": "./src/code/index.ts",
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./markdown": {
      "@glyphui/source": "./src/markdown/index.ts",
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./diff": {
      "@glyphui/source": "./src/diff/index.ts",
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    },
    "./media": {
      "@glyphui/source": "./src/media/index.ts",
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css"
  },
  "dependencies": {
    "@glyphui/tokens": "workspace:^",
    "@glyphui/ui": "workspace:^",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "diff": ">=8.0.0",
    "papaparse": "^5.4.0",
    "pdfjs-dist": ">=6.0.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-markdown": ">=9.0.0",
    "read-excel-file": ">=9.0.0",
    "remark-gfm": ">=4.0.0",
    "shiki": ">=3.0.0",
    "tailwindcss": ">=4.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "diff": {
      "optional": true
    },
    "papaparse": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "read-excel-file": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@glyphui/tsconfig": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "diff": "9.0.0",
    "jsdom": "^27.4.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "read-excel-file": "9.3.10",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
