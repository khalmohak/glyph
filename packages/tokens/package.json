{
  "name": "@glyphui/tokens",
  "version": "0.8.2",
  "description": "Framework-agnostic theme engine for Glyph: token schema, defineTheme, CSS generation and presets.",
  "license": "MIT",
  "author": "Mohak Gupta (https://github.com/khalmohak)",
  "homepage": "https://glyphui.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalmohak/glyph.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/khalmohak/glyph/issues"
  },
  "keywords": [
    "design-tokens",
    "theme",
    "oklch",
    "css-variables",
    "tailwindcss",
    "design-system",
    "ai",
    "ai-agents",
    "mcp",
    "llms-txt",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@glyphui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@glyphui/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "3.2.7",
    "tsdown": "^0.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
