{
  "name": "@glyphui/ui",
  "version": "0.8.2",
  "description": "React components on Tailwind CSS v4, built for AI coding agents: an MCP server and Markdown docs give agents the real API. One theme file sets the look; forms, data tables, app layouts and async states included.",
  "license": "MIT",
  "author": "Mohak Gupta (https://github.com/khalmohak)",
  "homepage": "https://glyphui.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalmohak/glyph.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/khalmohak/glyph/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "tailwind",
    "components",
    "ui",
    "design-system",
    "radix-ui",
    "theme",
    "dark-mode",
    "forms",
    "data-table",
    "react-router",
    "ai",
    "ai-agents",
    "mcp",
    "llms-txt",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@glyphui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./form": {
      "@glyphui/source": "./src/patterns/form/index.ts",
      "types": "./dist/form.d.ts",
      "default": "./dist/form.js"
    },
    "./data-table": {
      "@glyphui/source": "./src/patterns/data-table/index.ts",
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./data-table/virtual": {
      "@glyphui/source": "./src/patterns/data-table/virtual.ts",
      "types": "./dist/data-table-virtual.d.ts",
      "default": "./dist/data-table-virtual.js"
    },
    "./chart": {
      "@glyphui/source": "./src/patterns/chart/index.ts",
      "types": "./dist/chart.d.ts",
      "default": "./dist/chart.js"
    },
    "./react-router": {
      "@glyphui/source": "./src/integrations/react-router.tsx",
      "types": "./dist/react-router.d.ts",
      "default": "./dist/react-router.js"
    },
    "./vite": {
      "@glyphui/source": "./src/integrations/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles.css": "./styles.css",
    "./fonts.css": "./fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "fonts.css",
    "!src/**/*.test.tsx",
    "!src/**/*.test-d.tsx",
    "!src/test"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./fonts.css"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@glyphui/tokens": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "motion": "14.3.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@hookform/resolvers": ">=5.1.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7.55.0",
    "react-router": ">=7",
    "recharts": "^3.0.0",
    "tailwindcss": ">=4.1",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@glyphui/tsconfig": "workspace:*",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
